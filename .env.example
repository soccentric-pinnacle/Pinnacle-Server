# ─────────────────────────────────────────────────────────────────────────────
# Pinnacle Server — environment configuration
# Copy to .env and fill in all values before starting.
# All values may also be passed as real environment variables; .env is only
# for local development convenience.
# ─────────────────────────────────────────────────────────────────────────────

# ── Network ──────────────────────────────────────────────────────────────────
# Address the gRPC server listens on.
PINNACLE_GRPC_LISTEN=0.0.0.0:50051

# Address the HTTP/REST server (Drogon) listens on.
PINNACLE_HTTP_LISTEN=0.0.0.0:8080

# Address the Prometheus metrics endpoint listens on. Leave blank to disable.
PINNACLE_METRICS_LISTEN=0.0.0.0:9100

# ── Database ──────────────────────────────────────────────────────────────────
PINNACLE_DB_HOST=localhost
PINNACLE_DB_PORT=5432
PINNACLE_DB_NAME=pinnacle
PINNACLE_DB_USER=pinnacle
PINNACLE_DB_PASSWORD=changeme
PINNACLE_DB_POOL_SIZE=10
PINNACLE_DB_CONNECT_TIMEOUT_SEC=10

# ── Concurrency ──────────────────────────────────────────────────────────────
# Number of gRPC completion-queue threads (0 = hardware_concurrency).
PINNACLE_GRPC_THREADS=0

# Number of Drogon I/O threads (0 = hardware_concurrency).
PINNACLE_HTTP_THREADS=0

# ── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error | critical
PINNACLE_LOG_LEVEL=info

# ── Backpressure / Ingest ─────────────────────────────────────────────────────
# Maximum enqueued ResultEnvelopes per active stream before backpressure kicks in.
PINNACLE_STREAM_QUEUE_SIZE=1024

# Maximum enqueued log entries before backpressure kicks in.
PINNACLE_LOG_QUEUE_SIZE=4096

# ── Shutdown ──────────────────────────────────────────────────────────────────
# Seconds to wait for in-flight work to drain on SIGTERM/SIGINT.
PINNACLE_SHUTDOWN_TIMEOUT_SEC=30

# ── Registry ──────────────────────────────────────────────────────────────────
# Path to protos/registry/modules.yaml. Relative paths are resolved from CWD.
PINNACLE_REGISTRY_PATH=../protos/registry/modules.yaml

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret key used to sign session tokens (min 32 chars).
PINNACLE_SESSION_SECRET=change-this-to-a-random-secret-at-least-32-chars

# Argon2id parameters (memory in KiB, iterations, parallelism).
PINNACLE_ARGON2_MEM_KIB=65536
PINNACLE_ARGON2_ITER=3
PINNACLE_ARGON2_PARALLEL=4

# Max login attempts per IP per minute before rate-limiting.
PINNACLE_LOGIN_RATE_LIMIT=10

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Web UI.
PINNACLE_CORS_ORIGINS=http://localhost:3000

# ── OTA ──────────────────────────────────────────────────────────────────────
# Directory where uploaded OTA artifacts are stored.
PINNACLE_OTA_STORAGE_PATH=/var/lib/pinnacle/ota

# Path to the OTA signing public key (PEM). Leave empty to skip signature check.
PINNACLE_OTA_SIGNING_KEY_PATH=

# ── Email / SMTP ─────────────────────────────────────────────────────────────
PINNACLE_SMTP_HOST=
PINNACLE_SMTP_PORT=587
PINNACLE_SMTP_USER=
PINNACLE_SMTP_PASSWORD=
PINNACLE_SMTP_FROM=pinnacle@example.com
PINNACLE_SMTP_TLS=true
